# Server
PORT=3001

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# GitHub
GITHUB_TOKEN=
GITHUB_USERNAME=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Nur Bootstrap-Seed. Das aktive Token lebt in der Tabelle `spotify_auth`.
SPOTIFY_REFRESH_TOKEN=
# Pflicht für den Re-Auth: /spotify/auth?key=… und /spotify/status?key=…
SPOTIFY_ADMIN_KEY=
# Optional: eigene Spotify-User-ID — dann werden fremde Accounts abgelehnt.
SPOTIFY_OWNER_ID=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
